{
  "ci": {
    "collect": {
      "staticDistDir": "./build",
      "numberOfRuns": 1,
      "url": [
        "http://localhost/",
        "http://localhost/static-site-gen/",
        "http://localhost/rf-messenger/"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "skipAudits": ["uses-http2", "is-on-https", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "document-title": "error",
        "html-has-lang": "error",
        "meta-description": "error",
        "viewport": "error",
        "heading-order": "error",
        "link-name": "error",
        "link-text": "error",
        "target-size": "warn",
        "is-on-https": "off",
        "canonical": "off",
        "bf-cache": "off",
        "csp-xss": "off",
        "color-scheme": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
